# LLM 配置（二选一）
# 方式一：Ollama 本地模型（免费，需要安装 Ollama）
DEEPSEEK_API_KEY=ollama
DEEPSEEK_BASE_URL=http://localhost:11434/v1
DEEPSEEK_MODEL=qwen3:8b

# 方式二：DeepSeek API（云端，需注册获取 key）
# DEEPSEEK_API_KEY=sk-your-key-here
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# 数据库（PostgreSQL + pgvector）
# 如果使用 Docker: postgresql://kb_user:kb_pass@db:5432/knowledge_base
# 如果使用本地 PostgreSQL: postgresql://kb_user:kb_pass@localhost:5432/knowledge_base
DATABASE_URL=postgresql://kb_user:你的密码@localhost:5432/knowledge_base

# Redis（可选，没有则用内存缓存）
REDIS_URL=redis://localhost:6379/0

# Reranker 模型（可选，提升检索精度但需要 ~1.5GB 显存）
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Wiki 过期天数（超过此天数会在 Lint 中标记）
STALE_DAYS=90
